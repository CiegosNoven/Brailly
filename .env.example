# Keep this key on the server. Restart npm run dev after editing.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
PORT=5173
# Linux with distro-provided python3-brlapi:
BRLAPI_PYTHON=python3

# Optional integrations default off. Credentials stay in the server environment.
VISUAL_ENRICHMENT_ENABLED=false
BROWSERBASE_API_KEY=
# Optional explicit Browserbase project; leave empty to use the account default.
BROWSERBASE_PROJECT_ID=
# Comma-separated additional PUBLIC HTTPS origins, without paths or trailing slash.
# Deploy public/visual-demo.html to an allowed host before remote navigation.
BROWSERBASE_ALLOWED_ORIGINS=
ELEVENLABS_TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
